# Booking / Request Callback form → n8n webhook (n8n writes to Airtable server-side)
VITE_BOOKING_WEBHOOK_URL=https://your-n8n.railway.app/webhook/your-webhook-path

# Floating chat widget → n8n webhook (n8n handles its own Airtable save)
VITE_CHAT_WEBHOOK_URL=https://your-n8n.railway.app/webhook/xxx
